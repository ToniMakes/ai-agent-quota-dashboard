{
  "name": "ai-agent-quota-dashboard",
  "version": "0.1.0",
  "description": "Local-first quota dashboard for AI coding agents.",
  "type": "module",
  "private": true,
  "homepage": "https://github.com/isToniLiu/ai-agent-quota-dashboard#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isToniLiu/ai-agent-quota-dashboard.git"
  },
  "bugs": {
    "url": "https://github.com/isToniLiu/ai-agent-quota-dashboard/issues"
  },
  "bin": {
    "ai-agent-quota-dashboard": "./dist/index.js",
    "ai-agent-quota": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts --demo",
    "dev:local": "tsx src/index.ts",
    "desktop": "npm run build && electron desktop/main.cjs",
    "desktop:demo": "npm run build && electron desktop/main.cjs --demo",
    "desktop:first-run-smoke": "npm run build && electron --disable-gpu --disable-gpu-compositing --disable-gpu-sandbox --single-process desktop/main.cjs --smoke-first-run-guide",
    "desktop:local": "npm run build && electron desktop/main.cjs",
    "desktop:smoke": "npm run build && electron --disable-gpu --disable-gpu-compositing --disable-gpu-sandbox --single-process desktop/main.cjs --smoke",
    "doctor": "npm run build && node dist/index.js doctor",
    "trial:ready": "npm run build && node dist/index.js doctor --strict",
    "claude:self-test": "npm run build && node dist/index.js claude-statusline-sink --self-test",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "npm run build && node --test dist/**/*.test.js desktop/**/*.test.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "keywords": [
    "ai",
    "codex",
    "claude-code",
    "quota",
    "dashboard",
    "local-first"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "^43.3.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
